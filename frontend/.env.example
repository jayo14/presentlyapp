# Frontend Environment Variables

# Gemini API Key for AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Backend API URL
# Development: http://localhost:8000/api
# Production: https://your-production-api.com/api
VITE_API_URL=http://localhost:8000/api

# Mapbox Access Token for venue mapsAdd profile image edit
# Get your token from: https://account.mapbox.com/
# VITE_MAPBOX_TOKEN=pk.eyJ1IjoiY29kZWdhbGxhbnR4IiwiYSI6ImNtYWEyMW4yaTFzMnIybXM4cmFjaTgxMDQifQ.yMapfCCj0OPUcaK2Ik64rg

# Frontend URLs
# Development: http://localhost:3000
# Production: https://presentlyapp.vercel.app

# Firebase Cloud Messaging Configuration
# Get these values from Firebase Console: https://console.firebase.google.com/
# Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Cloud Messaging VAPID Key
# Get from Firebase Console: Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id
