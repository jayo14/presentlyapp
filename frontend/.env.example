# Backend API URL
# Development: http://localhost:8000 (normalization adds /api automatically)
# Production: https://your-render-backend.onrender.com (normalization adds /api automatically)
# Note: Do NOT include /api suffix here; the frontend will add it automatically
VITE_API_URL=http://localhost:8000

# Novu Application Identifier
