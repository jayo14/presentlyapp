# Frontend environment variables
# Copy this file to .env.local and replace placeholders with real values.
# Do not commit real secrets.

# API
VITE_API_URL=http://localhost:8000/api
VITE_SITE_URL=http://localhost:3000

# Auth
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Maps
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# Firebase (Web)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-key
VITE_ENABLE_FIREBASE_ANALYTICS=false

# AI Features
# Used by frontend/services/geminiService.ts
VITE_GEMINI_API_KEY=your-gemini-api-key

# Used by frontend/vite.config.ts build-time define
GEMINI_API_KEY=your-gemini-api-key

# Optional for Playwright E2E
PLAYWRIGHT_BASE_URL=http://localhost:3000
