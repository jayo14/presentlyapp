{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "API_URL": "https://presentlyapp-alpha.onrender.com/api"
      },
      "install": "npm install --legacy-peer-deps"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "API_URL": "https://presentlyapp-alpha.onrender.com/api"
      },
      "android": {
        "buildType": "apk"
      },
      "install": "npm install --legacy-peer-deps"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "API_URL": "https://presentlyapp-alpha.onrender.com/api"
      },
      "install": "npm install --legacy-peer-deps"
    }
  },
  "submit": {
    "production": {}
  }
}