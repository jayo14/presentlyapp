{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "API_URL": "https://presentlyapp.onrender.com/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "API_URL": "https://presentlyapp.onrender.com/api"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "API_URL": "https://presentlyapp.onrender.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
