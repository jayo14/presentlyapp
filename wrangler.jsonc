{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "presentlyapp",
  "compatibility_date": "2025-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend/dist"
  },
  "build": {
    "command": "cd frontend && pnpm install && pnpm build"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
