{
  "name": "presentlyapp",
  "main": "worker.mjs",
  "compatibility_date": "2024-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS"
  },
  "build": {
    "command": "cd frontend && npm install pnpm && CI=true npx pnpm install && npx pnpm run build"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_URL": "https://presentlyapp-alpha.onrender.com"
  }
}
