# Django Secret Key (generate a new one for production)
SECRET_KEY=django-insecure-replace-this-with-a-real-key

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# Redis Configuration (for Celery & Caching)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@presently.app

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=your-fcm-server-key
# Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# OR raw JSON content
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Google Maps API Key (for Location Verification)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Frontend URL & CORS

FRONTEND_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000



# Google OAuth 2.0

GOOGLE_CLIENT_ID=your-google-client-id

GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_AUTH_CALLBACK_URL=https://presentlyapp.vercel.app/auth/callback

# Gmail API
GMAIL_API_REFRESH_TOKEN=your_gmail_api_refresh_token
