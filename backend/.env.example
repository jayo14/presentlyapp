# Django Secret Key (generate a new one for production)
SECRET_KEY=django-insecure-replace-this-with-a-real-key

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# Redis Configuration (for Celery & Caching)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (Resend API)
RESEND_API_KEY=re_xxxxxxxxx
DEFAULT_FROM_EMAIL=Presently <noreply@getpresently.com.ng>
RESEND_TEMPLATE_WELCOME=your_template_id_here
RESEND_TEMPLATE_VERIFY_EMAIL=your_template_id_here
RESEND_TEMPLATE_LOGIN_ALERT=your_template_id_here
RESEND_TEMPLATE_RESET_PASSWORD=your_template_id_here
RESEND_TEMPLATE_SESSION_LIVE=your_template_id_here
RESEND_TEMPLATE_NEWSLETTER_WELCOME=your_template_id_here
RESEND_TEMPLATE_ATTENDANCE_CONFIRMED=your_template_id_here

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=your-fcm-server-key
# Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# OR raw JSON content
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Google Maps API Key (for Location Verification)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Frontend URL & CORS

FRONTEND_URL=http://localhost:5173
SUPPORT_URL=http://localhost:5173/support
PRIVACY_URL=http://localhost:5173/privacy
INSTITUTION_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000



# Google OAuth 2.0

GOOGLE_CLIENT_ID=your-google-client-id

GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Site Configuration
SITE_NAME=Presently

# Optional Gmail API (disabled by default)
USE_GMAIL_API_EMAIL_BACKEND=False
GMAIL_API_REFRESH_TOKEN=

# Multi-provider email failover providers
SENDPULSE_SMTP_USERNAME=
SENDPULSE_SMTP_PASSWORD=
MAILJET_SMTP_USERNAME=
MAILJET_SMTP_PASSWORD=
MAILTRAP_API_TOKEN=
AHASEND_SMTP_USERNAME=
AHASEND_SMTP_PASSWORD=
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=

# Optional per-provider daily throttling budgets (recipient count)
EMAIL_DAILY_BUDGET_RESEND=100
EMAIL_DAILY_BUDGET_SENDPULSE=400
EMAIL_DAILY_BUDGET_MAILJET=200
EMAIL_DAILY_BUDGET_MAILTRAP=150
EMAIL_DAILY_BUDGET_AHASEND=33
EMAIL_DAILY_BUDGET_GMAIL=500

# Cloudinary (for avatar/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
