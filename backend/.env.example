# Django Secret Key (generate a new one for production)
SECRET_KEY=django-insecure-replace-this-with-a-real-key

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# Redis Configuration (for Celery & Caching)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (Brevo SMTP)
# IMPORTANT: For Brevo SMTP relay, EMAIL_HOST_USER must be your Brevo SMTP login
# (e.g., "12345abc@smtp-brevo.com" from Brevo dashboard > SMTP & API > SMTP tab).
# EMAIL_HOST_PASSWORD must be your Brevo SMTP key (xsmtpsib-...).
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_brevo_smtp_login@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key-xsmtpsib-...
# Optional aliases (either EMAIL_HOST_PASSWORD or one of these must be set)
BREVO_SMTP_KEY=
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=noreply@getpresently.com.ng

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=your-fcm-server-key
# Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# OR raw JSON content
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Google Maps API Key (for Location Verification)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Frontend URL & CORS

FRONTEND_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000



# Google OAuth 2.0

GOOGLE_CLIENT_ID=your-google-client-id

GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Site Configuration
SITE_NAME=Presently

# Optional Gmail API (disabled by default)
USE_GMAIL_API_EMAIL_BACKEND=False
GMAIL_API_REFRESH_TOKEN=

# Cloudinary (for avatar/image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
